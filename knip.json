{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/__tests__/*.test.mjs",
        "scripts/container-services.mjs",
        "scripts/ci/smoke-production.mjs"
      ],
      "ignoreDependencies": ["mongodb"]
    },
    "packages/app": {
      "entry": [
        "pages/**/*.{ts,tsx}",
        "scripts/*.js",
        "tests/e2e/**/*.ts",
        "src/instrumentation.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "pages/**/*.{ts,tsx}"],
      "ignore": [".storybook/public/**"],
      "ignoreDependencies": [
        "@chromatic-com/storybook",
        "@storybook/addon-themes",
        "react-is",
        "@fontsource-variable/inter",
        "@fontsource-variable/roboto",
        "@fontsource-variable/roboto-mono",
        "@fontsource/ibm-plex-mono"
      ],
      "paths": {
        "next": ["./node_modules/vinext/dist/shims/next-shims-public.d.ts"],
        "next/*": ["./node_modules/vinext/dist/shims/*"],
        "next/compat/router": [
          "./node_modules/vinext/dist/shims/compat-router.js"
        ]
      }
    },
    "packages/api": {
      "entry": [
        "src/index.ts",
        "src/tasks/index.ts",
        "src/serverless.ts",
        "scripts/*.ts",
        "src/fixtures.ts",
        "src/__tests__/fixtures/tracing.ts",
        "src/tracing.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["pino-pretty", "aws4", "tslib"],
      "ignore": ["src/opamp/**", "src/utils/logParser.ts"]
    },
    "packages/common-utils": {
      "entry": ["src/**/*.ts", "!src/__tests__/**", "!src/**/*.test.*"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@stryker-mutator/core"],
      "ignoreBinaries": ["stryker"]
    },
    "packages/hdx-eval": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tslib"],
      "ignoreBinaries": ["claude"]
    }
  },
  "ignore": [
    "scripts/dev-portal/**",
    ".github/scripts/**",
    ".github/actions/**",
    "docker/hyperdx/**",
    ".claude/**"
  ],
  "ignoreBinaries": ["make", "migrate", "stryker"],
  "ignoreDependencies": [
    "@dotenvx/dotenvx",
    "concurrently",
    "dotenv",
    "@stryker-mutator/core",
    "jscpd"
  ],
  "include": ["nsExports"],
  "exclude": ["enumMembers", "duplicates"]
}
