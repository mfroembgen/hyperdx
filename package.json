{
  "name": "hyperdx",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@dotenvx/dotenvx": "2.38.2",
    "@eslint/js": "10.0.1",
    "@types/ungap__structured-clone": "1.2.0",
    "@ungap/structured-clone": "1.4.0",
    "concurrently": "10.0.6",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "lint-staged": "17.6.0",
    "nx": "24.0.2",
    "prettier": "3.9.10",
    "tslib": "2.8.1",
    "typescript-eslint": "8.72.1",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vitest": "5.0.5",
    "vite": "8.3.5",
    "@vitest/coverage-istanbul": "5.0.5",
    "typescript": "6.0.3"
  },
  "scripts": {
    "setup": "bun install --frozen-lockfile && husky",
    "build:common-utils": "nx run @hyperdx/common-utils:dev:build",
    "app:dev": "concurrently -k -n 'API,APP,ALERTS-TASK,COMMON-UTILS' -c 'green.bold,blue.bold,yellow.bold,magenta' 'nx run @hyperdx/api:dev 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\"$HDX_DEV_LOGS_DIR/api.log\"}' 'nx run @hyperdx/app:dev 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\"$HDX_DEV_LOGS_DIR/app.log\"}' 'nx run @hyperdx/api:dev-task check-alerts 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\"$HDX_DEV_LOGS_DIR/alerts.log\"}' 'nx run @hyperdx/common-utils:dev 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\"$HDX_DEV_LOGS_DIR/common-utils.log\"}'",
    "app:dev:local": "bash -c '. ./scripts/dev-env.sh && bun --bun run build:common-utils && concurrently -k -n \"APP,COMMON-UTILS\" -c \"blue.bold,magenta\" \"nx run @hyperdx/app:dev:local 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\\\"$HDX_DEV_LOGS_DIR/app.log\\\"}\" \"nx run @hyperdx/common-utils:dev 2>&1 | tee ${HDX_DEV_LOGS_DIR:+\\\"$HDX_DEV_LOGS_DIR/common-utils.log\\\"}\"'",
    "app:lint": "nx run @hyperdx/app:ci:lint",
    "app:storybook": "nx run @hyperdx/app:storybook",
    "build:clickhouse": "nx run @hyperdx/common-utils:build && nx run @hyperdx/app:build:clickhouse",
    "run:clickhouse": "nx run @hyperdx/app:run:clickhouse",
    "dev": "bash scripts/dev.sh",
    "dev:local": "IS_LOCAL_APP_MODE='DANGEROUSLY_is_local_app_mode\ud83d\udc80' bun --bun run dev",
    "cli:dev": "bun --bun run --filter @hyperdx/cli dev",
    "dev:down": "bash scripts/services.sh dev down && bash scripts/dev-kill-ports.sh",
    "dev:compose": "bash scripts/services.sh dev",
    "knip": "knip",
    "knip:ci": "knip --reporter json",
    "ratchet": "bun scripts/ci/ratchet.mjs",
    "ratchet:update": "bun scripts/ci/ratchet.mjs --update",
    "dupes": "bun scripts/ci/dupes.mjs",
    "dupes:all": "bun scripts/ci/dupes.mjs --all",
    "lint": "bun --bun x nx run-many -t ci:lint",
    "lint:fix": "bun --bun x nx run-many -t lint:fix",
    "version": "make version",
    "release": "bun --bun x changeset publish --no-git-tag && bun --bun x changeset tag",
    "prepare": "husky",
    "precommit": "lint-staged && knip --no-config-hints"
  },
  "lint-staged": {
    "packages/api/src/{routers/external-api/**/*.ts,utils/swagger.ts}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --quiet",
      "sh -c 'cd packages/api && bun --bun run lint:openapi && git add openapi.json'"
    ],
    "**/*.{mdx,json,yml}": [
      "prettier --write --ignore-unknown"
    ],
    "**/*.{ts,tsx,mts,cts}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --quiet"
    ]
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "typescript": "6.0.3",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3"
  },
  "patchedDependencies": {
    "@hyperdx/browser@0.26.0": "patches/hyperdx-browser-0.26.0.patch",
    "@hyperdx/passport-local-mongoose@9.0.1": "patches/hyperdx-passport-local-mongoose-9.0.1.patch",
    "playwright@1.64.1": "patches/playwright-1.64.1.patch"
  }
}
