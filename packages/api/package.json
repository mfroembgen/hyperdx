{
  "name": "@hyperdx/api",
  "version": "2.43.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "nx": {
    "targets": {
      "ci:lint": {
        "outputs": [
          "{projectRoot}/openapi.json"
        ]
      },
      "ci:unit": {
        "inputs": [
          "default",
          "^production",
          {
            "runtime": "bun --version"
          },
          "{workspaceRoot}/packages/app/next.config.mjs",
          "{workspaceRoot}/packages/app/package.json",
          "{workspaceRoot}/packages/app/scripts/parse-whats-new.js",
          "{workspaceRoot}/CHANGELOG.md"
        ]
      }
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai": "4.0.104",
    "@ai-sdk/otel": "1.0.156",
    "@braintree/sanitize-url": "7.1.2",
    "@esm2cjs/p-queue": "7.3.0",
    "@hyperdx/common-utils": "workspace:*",
    "@hyperdx/node-opentelemetry": "0.11.0",
    "@hyperdx/passport-local-mongoose": "9.0.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/host-metrics": "0.40.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@slack/webhook": "8.0.2",
    "@types/node": "26.6.6",
    "@workos-inc/node": "12.0.0",
    "ai": "7.0.156",
    "aws4": "1.13.2",
    "chrono-node": "2.10.3",
    "compression": "1.8.2",
    "concurrently": "10.0.6",
    "connect-mongo": "6.0.0",
    "cors": "2.8.6",
    "cron": "4.4.0",
    "date-fns": "4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "express-session": "1.19.0",
    "handlebars": "4.7.10",
    "http-graceful-shutdown": "4.0.0",
    "http-proxy-middleware": "4.2.1",
    "ip-address": "10.7.5",
    "jose": "6.2.14",
    "lodash": "4.18.1",
    "minimist": "1.2.8",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "ms": "2.1.3",
    "on-headers": "1.1.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "promised-handlebars": "2.0.1",
    "protobufjs": "8.8.1",
    "serialize-error": "13.0.2",
    "sqlstring": "2.3.3",
    "tslib": "2.8.1",
    "uuid": "14.0.3",
    "zod": "4.6.7",
    "@clickhouse/client": "1.24.1"
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "6.17.0",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/lodash": "4.17.27",
    "@types/minimist": "1.2.5",
    "@types/ms": "2.1.0",
    "@types/passport-local": "1.0.38",
    "@types/sqlstring": "2.3.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-jsdoc": "6.0.4",
    "@vitest/coverage-istanbul": "5.0.5",
    "ajv": "8.20.0",
    "migrate-mongo": "14.0.7",
    "pino-pretty": "13.2.0",
    "rimraf": "6.1.3",
    "supertest": "7.3.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "tsc-alias": "1.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@opentelemetry/sdk-trace": "3.0.0"
  },
  "scripts": {
    "start": "bun --preload ./build/tracing.js ./build/index.js",
    "dev": "bun --watch --env-file=.env.development --preload ./src/tracing.ts ./src/index.ts",
    "dev:mcp": "bunx --bun @modelcontextprotocol/inspector",
    "dev-task": "bun --watch --env-file=.env.development --preload ./src/tracing.ts ./src/tasks/index.ts",
    "build": "rimraf ./build && tsrs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && cp -r ./src/opamp/proto ./build/opamp/",
    "build:vercel": "rimraf ./build && tsrs -p tsconfig.vercel.json && tsc-alias -p tsconfig.vercel.json && cp -r ./src/opamp/proto ./build/opamp/",
    "lint": "bun --bun run eslint . --ext .ts --max-warnings 302",
    "lint:fix": "bun --bun run eslint . --ext .ts --fix",
    "ci:lint": "bun run lint && bun run tsrs --noEmit && bun run lint:openapi",
    "ci:unit": "CI=1 bun --bun run vitest run --coverage",
    "dev:unit": "bun --bun run vitest",
    "ci:int": "dotenvx run --file=.env.test --overload -- bun --no-env-file --bun run vitest run --config vitest.int.config.ts",
    "dev:int": "dotenvx run --file=.env.test --overload -- bun --no-env-file --bun run vitest --config vitest.int.config.ts --coverage",
    "dev:migrate-db-create": "migrate-mongo create -f migrate-mongo-config.ts",
    "dev:migrate-db": "migrate-mongo up -f migrate-mongo-config.ts",
    "dev:migrate-ch-create": "migrate create -ext sql -dir ./migrations/ch -seq",
    "dev:migrate-ch": "migrate -database 'clickhouse://localhost:9000?database=default&x-multi-statement=true' -path ./migrations/ch up",
    "docgen": "bun scripts/generate-api-docs.ts",
    "seed:alerts": "../../scripts/with-slots.sh bun scripts/seed-alerts.ts",
    "lint:openapi": "bun run docgen && spectral lint openapi.json"
  }
}
