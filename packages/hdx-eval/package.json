{
  "name": "@hyperdx/hdx-eval",
  "version": "0.3.3-fork.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": "./dist/cli.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.91",
    "@ai-sdk/openai": "4.0.104",
    "@clickhouse/client": "1.24.1",
    "ai": "7.0.156",
    "commander": "15.0.0",
    "ms": "2.1.3",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ms": "2.1.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-istanbul": "5.0.5",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "rimraf ./dist && tsrs -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "./scripts/env.sh bun src/cli.ts",
    "lint": "bun --bun run eslint . --ext .ts --max-warnings 0",
    "lint:fix": "bun --bun run eslint . --ext .ts --fix",
    "ci:lint": "bun run lint && bun run tsrs --noEmit",
    "ci:unit": "CI=1 bun --bun run vitest run --coverage",
    "dev:unit": "bun --bun run vitest",
    "viewer": "bun scripts/viewer/server.js"
  }
}
