{
  "name": "@hyperdx/app",
  "version": "2.42.0-fork.2-rc.4",
  "private": true,
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --env-file=.env.development --bun ../../node_modules/vite/bin/vite.js dev --port ${PORT:-3000}",
    "dev:local": "NEXT_PUBLIC_IS_LOCAL_MODE=true bun --env-file=.env.development --bun ../../node_modules/vite/bin/vite.js dev --port ${PORT:-3000}",
    "build": "bun --bun ../../node_modules/vite/bin/vite.js build && bun scripts/prepare-standalone.mjs",
    "build:clickhouse": "NEXT_PUBLIC_THEME=clickstack NEXT_PUBLIC_IS_LOCAL_MODE=true NEXT_PUBLIC_CLICKHOUSE_BUILD=true bun run build && bun scripts/prepare-clickhouse-build-export.js",
    "run:clickhouse": "test -d out && rimraf tmp && mkdir tmp && cp -r out tmp/clickstack && echo 'visit http://localhost:3000/clickstack to start' && serve tmp -l 3000 || echo 'run build:clickhouse first'",
    "start": "NODE_ENV=production bun --env-file=.env --env-file=.env.production --env-file=.env.local --env-file=.env.production.local server.mjs",
    "lint": "bunx --bun --no-install eslint . --ext .ts,.tsx --max-warnings 568",
    "lint:fix": "bunx --bun --no-install eslint . --ext .ts,.tsx --fix",
    "lint:styles": "bun --bun run stylelint \"styles/**/*.{css,scss}\" \"src/**/*.{css,scss}\"",
    "ci:lint": "bun run lint && bunx --bun --no-install tsrs --noEmit && bun run lint:styles --quiet",
    "ci:unit": "bun --bun ../../node_modules/vitest/vitest.mjs run --coverage",
    "dev:unit": "bun --bun ../../node_modules/vitest/vitest.mjs",
    "test:e2e": "bun scripts/run-e2e.js",
    "test:e2e:ci": "../../scripts/test-e2e-ci.sh",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build:vercel": "HDX_PREVIEW_INLINE_API=true bun run build && bun scripts/prepare-vercel.mjs"
  },
  "dependencies": {
    "@clickhouse/click-ui": "0.15.0",
