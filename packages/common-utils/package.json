{
  "name": "@hyperdx/common-utils",
  "description": "Common utilities for HyperDX application",
  "version": "0.32.0-fork.1",
  "license": "MIT",
  "private": true,
  "files": [
    "dist/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "@clickhouse/client-common": "1.23.0",
    "@clickhouse/client-web": "1.24.0",
    "@hyperdx/lucene": "3.1.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.11",
    "@prometheus-io/lezer-promql": "0.315.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "handlebars": "4.7.10",
    "lodash": "4.18.1",
    "node-sql-parser": "5.4.0",
    "object-hash": "3.0.0",
    "sql-formatter": "15.9.0",
    "sqlstring": "2.3.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/hyperdx__lucene": "npm:@types/lucene@2.1.7",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.5",
    "@types/object-hash": "3.0.6",
    "@types/sqlstring": "2.3.2",
    "@vitest/coverage-istanbul": "5.0.5",
    "nodemon": "3.1.14",
    "tsc-alias": "1.9.9",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "scripts": {
    "dev": "nodemon --on-change-only --watch ./src --ext ts --exec \"bun run dev:build\"",
    "dev:build": "tsup && tsrs --emitDeclarationOnly --declaration && tsc-alias",
    "build": "tsup",
    "ci:build": "tsup",
    "lint": "bun --bun run eslint . --ext .ts --max-warnings 80",
    "lint:fix": "bun --bun run eslint . --ext .ts --fix",
    "ci:lint": "bun run lint && bun run tsrs --noEmit",
    "ci:unit": "CI=1 bun --bun run vitest run --coverage",
    "dev:unit": "bun --bun run vitest",
    "ci:int": "bun --env-file=.env.test --bun run vitest run --config vitest.int.config.ts --coverage",
    "dev:int": "bun --env-file=.env.test --bun run vitest --config vitest.int.config.ts",
    "dev:mutation": "bun --preload=@stryker-mutator/vitest-runner ./node_modules/@stryker-mutator/core/bin/stryker.js run"
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/clickhouse": {
      "import": {
        "types": "./dist/clickhouse/index.d.mts",
        "default": "./dist/clickhouse/index.mjs"
      },
      "require": {
        "types": "./dist/clickhouse/index.d.ts",
        "default": "./dist/clickhouse/index.js"
      }
    },
    "./dist/drain": {
      "import": {
        "types": "./dist/drain/index.d.mts",
        "default": "./dist/drain/index.mjs"
      },
      "require": {
        "types": "./dist/drain/index.d.ts",
        "default": "./dist/drain/index.js"
      }
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*.mjs": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./dist/*": {
      "import": {
        "types": "./dist/*.d.mts",
        "default": "./dist/*.mjs"
      },
      "require": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "./dist/*.d.ts": "./dist/*.d.ts",
    "./dist/*.d.mts": "./dist/*.d.mts"
  }
}
